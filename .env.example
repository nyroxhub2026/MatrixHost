# ==========================================
# MATRIXHOST ENVIRONMENT
# ==========================================

NODE_ENV=development
MATRIXHOST_NAME=MatrixHost
MATRIXHOST_VERSION=1.0.0

# ==========================================
# PANEL
# ==========================================

PANEL_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MatrixHost
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==========================================
# API
# ==========================================

API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ==========================================
# DATABASE
# ==========================================

POSTGRES_DB=matrixhost
POSTGRES_USER=matrixhost
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_PORT=5432

DATABASE_URL=postgresql://matrixhost:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/matrixhost?schema=public

# ==========================================
# REDIS
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@localhost:6379

# ==========================================
# NODE AGENT
# ==========================================

NODE_AGENT_PORT=8080

# Per-node values are generated by the Node credential workflow.
NODE_ID=
API_BASE_URL=https://your-api-domain.example
AGENT_TOKEN=
AGENT_VERSION=1.0.0
HEARTBEAT_INTERVAL_MS=15000
RECONNECT_INTERVAL_MS=5000
LOG_LEVEL=info
AGENT_STORAGE_PATH=/var/lib/matrixhost-agent

# Docker Agent
DOCKER_BINARY=docker
DOCKER_COMMAND_TIMEOUT_MS=30000
DOCKER_MAX_BUFFER_BYTES=1048576
DOCKER_REQUIRE_AVAILABLE=true
DOCKER_DEFAULT_PIDS_LIMIT=512
DOCKER_ALLOWED_IMAGE_PREFIXES=ghcr.io/pterodactyl/yolks:
DOCKER_MANAGED_LABEL=matrixhost.managed

# ==========================================
# STORAGE
# ==========================================

DATA_DIRECTORY=./storage
BACKUP_DIRECTORY=./storage/backups
TEMP_DIRECTORY=./storage/temp

# ==========================================
# SECURITY
# ==========================================

CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
